# Backend Verifier Private Key (REQUIRED for /scanned_palm endpoint)
# This is the private key of the backend verifier wallet
# This wallet must be set as the backendVerifier in the PalmPay contract
BACKEND_PRIVATE_KEY=your_private_key_here_without_0x_prefix

# Blockchain RPC URL (REQUIRED)
# For Sepolia testnet with Infura:
RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID
# For Sepolia with Alchemy:
# RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY

# PalmPay Contract Address (REQUIRED)
# The deployed PalmPay smart contract address
PALMPAY_CONTRACT_ADDRESS=0x438E989d5eb3009caB3554D076415C7BBE845a48

# Chain ID (REQUIRED)
# 11155111 = Sepolia testnet
# 1 = Ethereum mainnet
CHAIN_ID=11155111

# Palm Recognition Configuration (OPTIONAL)
# Directory where registered palm images are stored
REGISTERED_PALMS_DIR=./registered_palms

# Similarity threshold for palm matching (0.0 to 1.0)
# Lower = more strict, Higher = more lenient
SIMILARITY_THRESHOLD=0.15
