# Private key for deployment wallet (DO NOT COMMIT ACTUAL .env FILE)
SEPOLIA_PRIVATE_KEY=your_private_key_here_without_0x_prefix

# RPC URLs with API keys
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Etherscan API key for contract verification
ETHERSCAN_API_KEY=(optional)

# Store private key for testing
PKEY_STORE=your_store_private_key_here_without_0x_prefix